@using StockSim.Frontend.Models
@using StockSim.Frontend.Services
@using StockSim.Frontend.Components
@using Microsoft.AspNetCore.Components
@inject IStockService StockService
@inject ITokenService TokenService
@inject IUserService UserService
@inject NavigationManager NavigationManager

<div id="intervals" role="group" aria-label="Graph time range">
    @foreach (var option in Intervals) {
        <button type="button" class="period @(option.Period == Active ? "period-active" : "")"
                aria-pressed="@(option.Period == Active)"
                @onclick="() => Select(option)">@option.Label</button>
    }
</div>

