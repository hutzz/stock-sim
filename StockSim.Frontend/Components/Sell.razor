@using StockSim.Frontend.Models
@using StockSim.Frontend.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inject NavigationManager NavigationManager
@inject ITokenService TokenService
@inject IStockService StockService

<div class="trade-block">
    <EditForm Model="@stock" OnValidSubmit="Valid" OnInvalidSubmit="Invalid" class="trade-form">
        <DataAnnotationsValidator />
        <div class="trade-row">
            <label class="trade-label" for="sell-quantity">Quantity to sell</label>
            <InputNumber class="trade-input" id="sell-quantity" @bind-Value="_quantity" placeholder="0" aria-label="Shares to sell" required />
            <button type="submit" class="trade-submit trade-submit-sell">Sell @Symbol</button>
            <ValidationMessage class="trade-validation-message" For="() => stock.Quantity" />
        </div>
    </EditForm>
</div>
