@page "/search"
@attribute [Authorize]
@using StockSim.Frontend.Models
@using StockSim.Frontend.Services
@using StockSim.Frontend.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inject IStockService StockService
@inject ITokenService TokenService
@inject IUserService UserService
@inject ISearchService SearchService
@inject NavigationManager NavigationManager

<PageTitle>Search</PageTitle>

<AuthorizeView>
    <Authorized>
        <div id="wrapper">
            <Navbar />
            <main id="content">
                <header id="intro">
                    <h1 class="title">Find a stock</h1>
                    <p class="subtitle">Search by company name or ticker symbol.</p>
                </header>
                <section id="search-panel" aria-label="Stock search">
                    <div id="search-area">
                        <form id="search-form" @onsubmit="SearchStock">
                            <button id="search-submit" type="submit" title="Go to this ticker" aria-label="Search">
                                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            </button>
                            <input id="stock-search" type="text" @bind="@searchTerm" @bind:event="oninput" placeholder="Search stocks..." autocomplete="off" aria-label="Search stocks" />
                        </form>
                        @if (!string.IsNullOrWhiteSpace(searchTerm)) {
                            <ul id="search-results" aria-label="Search results">
                                @foreach (var stock in filteredStocks) {
                                    <li>
                                        <a class="result-link" href="https://localhost:7003/stock/@stock.Ticker">
                                            <span class="result-name">@stock.Name</span>
                                            <span class="result-ticker">@stock.Ticker</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <p class="search-hint">Type a company name, or enter a ticker and press Enter to open it.</p>
                </section>
            </main>
        </div>
    </Authorized>
</AuthorizeView>
