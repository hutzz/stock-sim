@page "/dashboard"
@attribute [Authorize]
@using StockSim.Frontend.Models
@using StockSim.Frontend.Services
@using StockSim.Frontend.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inject IStockService StockService
@inject ITokenService TokenService
@inject IUserService UserService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (!string.IsNullOrEmpty(user.Username)) {
            <div id="wrapper">
                <Navbar />
                <main id="content">
                    <header id="intro">
                        <h1 class="title">Welcome, @user.Username!</h1>
                        <p class="subtitle">Here's how your portfolio is doing today.</p>
                    </header>
                    <section id="summary" aria-label="Account summary">
                        <div class="stat-card">
                            <span class="stat-label">Cash in account</span>
                            <span class="stat-value">$@CashBalance.ToString("F2")</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-label">Value of stocks owned</span>
                            <span class="stat-value">$@StocksValue.ToString("F2")</span>
                        </div>
                        <div class="stat-card stat-card-total">
                            <span class="stat-label">Total account value</span>
                            <span class="stat-value">$@TotalValue.ToString("F2")</span>
                        </div>
                    </section>
                    <section id="holdings-panel" aria-label="Stocks you own">
                        <div id="panel-header">
                            <h2 class="panel-title">Your holdings</h2>
                            <span class="panel-meta">@((userStocks.Count == 1) ? "1 position" : $"{userStocks.Count} positions")</span>
                        </div>
                        @if (_loading) {
                            <p class="empty-note">Loading your holdings&hellip;</p>
                        }
                        else if (userStocks.Count > 0) {
                            <div id="stock-menu-wrapper">
                                @foreach (var stock in userStocks) {
                                    var change = stock.Change;
                                    var trendClass = change is null ? "trend-flat" : (change >= 0 ? "trend-up" : "trend-down");
                                    var trendIcon = change is null ? "fa-minus" : (change >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down");
                                    <a class="stock-card" href="@($"https://localhost:7003/stock/{stock.Symbol}")">
                                        <div class="stock-top">
                                            <h3 class="stock-symbol">@stock.Symbol</h3>
                                            <span class="stock-quantity">@($"{stock.Quantity} owned")</span>
                                        </div>
                                        <div class="stock-price-row">
                                            <span class="stock-unit-price">$@Math.Round(stock.Price, 2).ToString("F2")</span>
                                            <span class="stock-per-share">per share</span>
                                        </div>
                                        <div class="stock-bottom">
                                            <span class="stock-value">$@stock.TotalValue.ToString("F2")</span>
                                            <span class="@trendClass" title="Change in unit price since the previous close">
                                                <i class="fa-solid @trendIcon" aria-hidden="true"></i>
                                                @if (change is not null) {
                                                    <span class="trend-text">@($"{(change >= 0 ? "+" : "")}{change.Value.ToString("F2")} / sh")</span>
                                                }
                                            </span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else {
                            <p class="empty-note">You do not have any stocks. Use <a href="/search">Search</a> to find something to buy.</p>
                        }
                    </section>
                    @if (!string.IsNullOrEmpty(_message)) {
                        <div class="validation-message">@_message</div>
                    }
                </main>
            </div>
        }
    </Authorized>
</AuthorizeView>
